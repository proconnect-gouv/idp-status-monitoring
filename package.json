{
  "name": "idp-status-monitoring",
  "version": "2026.10.0",
  "private": true,
  "workspaces": [
    "idp-status-monitoring-consumer",
    "idp-status-monitoring-producer"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "release-it": {
    "github": {
      "release": true
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@csmith/release-it-calver-plugin": {
        "cycle": "month"
      }
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "7.0.2"
  }
}
